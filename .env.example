# ==========================================
# FitMaster AI - Environment Configuration
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fitmaster_ai
DB_CONNECTION_LIMIT=10

# JSON Web Token (JWT) Configuration
JWT_SECRET=fitmaster_super_secret_jwt_key_2026_academic_project
JWT_EXPIRES_IN=7d

# Python AI Microservice Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=10000

# AI Microservice Internal Settings (Used by FastAPI)
AI_HOST=0.0.0.0
AI_PORT=8000
AI_DEBUG=True
MODEL_STORAGE_PATH=./saved_models
CHARTS_STORAGE_PATH=./generated_charts
